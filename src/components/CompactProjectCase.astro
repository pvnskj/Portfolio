---
import type { Project } from '../data/projects';

interface Props { project: Project; prev: Project; next: Project; }
const { project, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type CardContent = {
  kicker: string;
  title: string;
  takeaway: string;
  takeawayStrong: string;
  problemHead: string;
  problemText: string;
  approachHead: string;
  approachText: string;
  flow: string[];
  ownership: [string, string][];
  outcomes: [string, string, string][];
  decisions: [string, string][];
  storyVideo?: string;
};

const CONTENT: Record<string, CardContent> = {
  'rag-analysis-agent': {
    kicker: 'AI · Analysis agent',
    title: 'Enterprise RAG Analysis Agent',
    storyVideo: 'videos/rag-groom.mp4',
    takeaway: 'From ~10 days of analysis to ~6 hours with the agent — ',
    takeawayStrong: 'grounded, cited, human-validated.',
    problemHead: 'Analysis was consuming a sprint.',
    problemText: 'A typical feature request consumed nearly an entire two-week sprint before development started: about six days of business analysis followed by four days of technical analysis.',
    approachHead: 'One grounded analysis across business + code.',
    approachText: 'Unify fragmented business and technical knowledge into one grounded, human-validated analysis workflow.',
    flow: ['Engineering sources', 'Permission-aware retrieval', 'Grounding gate', 'Cited answer'],
    ownership: [
      ['Reframe the product', 'from conversational chatbot to grounded technical-analysis agent.'],
      ['Define the grounding gate', 'require abstention when evidence is insufficient.'],
      ['Golden-dataset CI gate', 'retrieval and answer-quality regression testing.'],
      ['Prioritize live integrations', 'engineering-system connectors ahead of broader UI work.'],
      ['Lead to production', 'from local Python proof of concept to production architecture.'],
    ],
    outcomes: [
      ['~10 days → ~6 hrs', 'Analysis work', 'Measured'],
      ['1–2 days', 'Story movement', 'Observed'],
      ['11GB+', 'Knowledge corpus', 'Observed'],
      ['558+', 'Projects searchable', 'Observed'],
    ],
    decisions: [
      ['Choose accuracy over conversational speed', 'Reranking and grounding verification add latency, but production troubleshooting needs actionable evidence.'],
      ['Use live enterprise context', 'Live integrations let the agent work against current authorized engineering state.'],
      ['Make evaluation a release gate', 'Retrieval, chunking, or prompting changes must pass a golden set of historical failures.'],
      ['Protect retrieval during index refresh', 'Large indexing cycles build away from active reads and swap safely when ready.'],
    ],
  },
  'build-plus': {
    storyVideo: 'videos/buildplus-story.mp4',
    kicker: 'Operations · Supply chain',
    title: 'Build Plus',
    takeaway: 'Deliberate trade-offs won the FCC deadline — ',
    takeawayStrong: 'now one governed asset lifecycle is cutting cost and lifting efficiency.',
    problemHead: 'An FCC deadline that couldn\u2019t move.',
    problemText: 'With the date at risk, more than half of MRO fulfillment depended on spreadsheets, part data moved manually between systems, demand was reactive, and no workflow preserved asset identity through forward and reverse logistics. Hitting the date required deliberate per-domain trade-offs \u2014 speed first, coherence second.',
    approachHead: 'Two ideal states, sequenced.',
    approachText: 'First the compliance win: make the FCC date. Now the efficiency win: one governed operating model from part definition through demand, fulfillment, custody, and recovery \u2014 framed through workshops with the business, where trusted identity becomes the common key.',
    flow: ['Master data foundation', 'Predictive planning', 'Systemized fulfillment', 'Lifecycle closure'],
    ownership: [
      ['Framed both ideal states', 'sequencing the compliance win before the efficiency drive.'],
      ['Ran the business workshops', 'across procurement, inventory, planning & forecasting, fault reports, movement & tracking, vendor and lease impacts.'],
      ['Architect the Item Master first', 'governed taxonomy and codification before downstream automation.'],
      ['Shifted to predictive demand', 'from reactive purchasing to an 18-month demand signal.'],
      ['Closed the lifecycle', 'serialization, reverse-logistics RACI, fault reporting, and disposition.'],
    ],
    outcomes: [
      ['50%+', 'MRO on spreadsheets', 'Measured baseline'],
      ['18 mo', 'Rolling demand horizon', 'Implemented'],
      ['10,040', 'Hours returned / year', 'Projected'],
      ['19', 'Manual handoffs addressed', 'Measured'],
    ],
    decisions: [
      ['Trade-offs, not shortcuts', 'Per-domain customization was a deliberate choice to make the date \u2014 speed first, coherence second.'],
      ['Establish the data anchor first', 'Trusted part identity before automating the lifecycle.'],
      ['Generate demand from evidence', 'Consumption and rollout signals over spreadsheet inference.'],
      ['Validate before fulfillment', 'The BOM gate prevents errors upstream instead of discovering them in the field.'],
    ],
  },
  'gl-coding': {
    storyVideo: 'videos/gl-story.mp4',
    kicker: 'Finance · Configurable policy',
    title: 'Dynamic GL Coding',
    takeaway: 'Close is 40% faster with fewer reviews and less manual work \u2014 ',
    takeawayStrong: 'GL changes no longer cost sprints of deployments and CAB reviews.',
    problemHead: 'Every modification meant CAB, review, code, deploy.',
    problemText: 'In an asset-heavy business the GL code hinged on the project \u2014 a new build went one place, a modification went another, and modifications depended on when and how the asset was installed. Close consumed days of reviews and manual workload, and every modification burned sprints of deployments and CAB reviews. The spreadsheet path couldn\u2019t keep up.',
    approachHead: 'Configuration, not code.',
    approachText: 'Dynamic GL coding decomposes the 6-segment string — company, department, account, activity, facility, functioning — into permissioned lookup tables, with the asset tied to its code. Approvers sign off once; codes flow into the project and auto-post to Oracle and billing.',
    flow: ['Common identity', 'Policy configuration', 'Routing & validation', 'Reconciliation & evidence'],
    ownership: [
      ['Designed dynamic GL coding', 'the configuration-based replacement for the spreadsheet path.'],
      ['Decomposed the 6-segment string', 'into permissioned lookup tables only authorized people can assign.'],
      ['Tied assets to codes', 'so the asset itself carries its GL identity.'],
      ['Built the approval flow', 'assign \u2192 approve \u2192 automatic posting to Oracle and billing.'],
      ['Championed the 4-month redesign', 'over another project-specific quick fix.'],
    ],
    outcomes: [
      ['40%', 'Faster month-end close', 'Measured'],
      ['2\u20133 mo \u2192 <1 wk', 'Portfolio onboarding', 'Estimated'],
      ['4+', 'Portfolios onboarded', 'Observed'],
      ['3', 'Systems, one project identity', 'Actual'],
    ],
    decisions: [
      ['Decouple policy from code', 'Mappings live in governed metadata \u2014 no release per policy change.'],
      ['Validate before posting', 'Bad combinations stop before the ledger, not at reconciliation.'],
      ['One common project identity', 'Operations, warehouse, and ERP describe the same activity identically.'],
      ['Scalability over the quick fix', 'A 4-month redesign beat another branch of conditional logic.'],
    ],
  },
  'lease-vendor-management': {
    storyVideo: 'videos/lease-story.mp4',
    kicker: 'Real estate · Financial controls',
    title: 'Lease & Vendor Management',
    takeaway: '$23.7M in monthly rent, governed — ',
    takeawayStrong: 'invalid vendor and payment combinations never reach Finance.',
    problemHead: 'A spreadsheet liability at $23.7M/month scale.',
    problemText: 'Thousands of site leases ran on fragmented real-estate data and manual payment workarounds. The legacy vendor model allowed only three active rent addresses per vendor, and payment requests could reach Finance with inactive vendors or missing Oracle identifiers — recurring operational, financial, and compliance risk.',
    approachHead: 'Financial controls at the source.',
    approachText: 'A ground-up lease-to-pay platform: lease lifecycle state, vendor eligibility, rent addresses, Oracle identifiers, GL treatment, and payment evidence as one governed process. Error detection moved from downstream Finance review to the moment data becomes eligible for payment.',
    flow: ['Lease lifecycle foundation', 'Vendor scalability', 'Payment controls', 'Financial integrity'],
    ownership: [
      ['Defined lease-to-pay as financial control', 'not a real-estate database.'],
      ['Designed the eligibility gate', 'vendor status, rent address, and Oracle IDs checked before approval.'],
      ['Removed the 3-address limit', 'replaced with a scalable multi-address landlord model.'],
      ['Connected vendor data dynamically', 'into lease payment generation.'],
      ['Integrated GL/CIP treatment', 'balancing governance against user speed.'],
    ],
    outcomes: [
      ['$23.7M/mo', 'Rent roll governed', 'Actual'],
      ['3 \u2192 scalable', 'Rent-address model', 'Implemented'],
      ['~150', 'Stories delivered', 'Actual'],
      ['~2x', 'Estimated ROI', 'Estimated'],
    ],
    decisions: [
      ['Validate eligibility at the source', 'Invalid combinations stop upstream instead of becoming Finance rework.'],
      ['Remove the structural limit', 'Unlimited addresses replaced the constraint driving payment workarounds.'],
      ['Lease data is financial-control data', 'Recurring rent is a financial obligation, not document tracking.'],
      ['Control over one-click speed', 'Validation friction was deliberate — bad instructions never enter the ERP path.'],
    ],
  },
  'rfds': {
    storyVideo: 'videos/rfds-story.mp4',
    kicker: 'Operations · Field operations',
    title: 'Site Engineering & Field Operations Automation',
    takeaway: 'From fragmented site documents to ',
    takeawayStrong: 'milestone-driven field workflow.',
    problemHead: 'Field work was running on fragmented information.',
    problemText: 'Installation diagrams lived across individual repositories and local versions, with no reliable history and no easy way to confirm the latest document matched the site.',
    approachHead: 'One governed path from site change to field completion.',
    approachText: 'Generate current site information from trusted enterprise data and let the milestone drive when contractor work begins.',
    flow: ['Site milestone', 'Trusted enterprise data', 'Contractor execution', 'Payment trigger'],
    ownership: [
      ['Shift the product model', 'from document creation to governed engineering data.'],
      ['Codify engineering judgment', 'as explicit, testable rules and metadata.'],
      ['Enforce source validation', 'even when it added friction to user entry.'],
      ['Keep a controlled urgent path', 'with approved equipment and validated inputs.'],
      ['Connect to execution', 'approved design context flowing to downstream operations.'],
    ],
    outcomes: [
      ['$1.2M', 'Annual cost avoidance', 'Measured'],
      ['2–4 hrs → <30 sec', 'Single-site generation', 'Measured'],
      ['~15 min', 'Bulk processing', 'Observed'],
      ['1,000+', 'Designs per month', 'Observed'],
    ],
    decisions: [
      ['Model knowledge as data and rules', 'Centralized site and equipment attributes with configuration-driven logic.'],
      ['Validate at the source', 'Required fields, approved equipment, and cross-source checks prevent invalid configurations.'],
      ['Govern flexibility', 'Strict lookups reduced freedom but kept designs consistent at rollout scale.'],
      ['Align fulfillment with approved design', 'Shipped parts validated against the approved configuration.'],
    ],
  },
};

const c = CONTENT[project.slug]!;
---

<main class="cpc-page shell">
  <nav class="cpc-bar" aria-label="Project navigation">
    <a href={`${base}/work/${prev.slug}/`} title={prev.title}>← {prev.title}</a>
    <b>{c.title}</b>
    <a href={`${base}/work/${next.slug}/`} title={next.title}>{next.title} →</a>
  </nav>

  <header class="cpc-hero">
    <p class="cpc-kicker">{c.kicker}</p>
    <h1>{c.title}</h1>
    <p class="cpc-takeaway">{c.takeaway}<strong>{c.takeawayStrong}</strong></p>
  </header>

  <div class="cpc-grid">
    <section class="cpc-quad q-problem">
      <span>Problem</span>
      <h2>{c.problemHead}</h2>
      <p>{c.problemText}</p>
    </section>

    <section class="cpc-quad q-approach">
      <span>Approach</span>
      <h2>{c.approachHead}</h2>
      <p>{c.approachText}</p>
      <div class="cpc-steps">{c.flow.map((step) => <span>{step}</span>)}</div>
    </section>

    <section class="cpc-quad q-own">
      <span>Ownership</span>
      <h2>What I owned</h2>
      <ul>
        {c.ownership.map(([title, text]) => <li><strong>{title}</strong> — {text}</li>)}
      </ul>
    </section>

    <section class="cpc-quad q-results">
      <span>Results</span>
      <h2>Measured outcomes</h2>
      {c.storyVideo ? (
        <video class="cpc-story-video" src={`${base}/${c.storyVideo}`} autoplay muted loop playsinline preload="metadata" aria-label="Animated story: from problem to solution, ending with measured outcomes"></video>
      ) : (
      <div class="cpc-metrics">
        {c.outcomes.map(([value, label, type]) => (
          <div class="cpc-metric"><strong>{value}</strong><small>{label}</small><em>{type}</em></div>
        ))}
      </div>
      )}
    </section>
  </div>

  <section class="cpc-decisions" aria-label="Key decisions">
    <span>Judgment calls</span>
    <div class="cpc-decision-grid">
      {c.decisions.map(([title, text], i) => (
        <article><b>{String(i + 1).padStart(2, '0')}</b><div><h3>{title}</h3><p>{text}</p></div></article>
      ))}
    </div>
  </section>

  <a class="cpc-next" href={`${base}/work/${next.slug}/`}><span>Next project</span><strong>{next.title} →</strong></a>
</main>

<style>
  .cpc-page { max-width: 1200px; margin: 0 auto; padding-bottom: 48px; }
  .cpc-bar { display: flex; justify-content: space-between; align-items: center; padding: 14px 32px; border-bottom: 1px solid #e2e8f0; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: #64748b; }
  .cpc-bar a { color: #64748b; text-decoration: none; max-width: 34%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cpc-bar a:hover { color: #0f172a; }
  .cpc-bar b { color: #334155; font-weight: 700; max-width: 30%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cpc-hero { padding: 34px 32px 20px; }
  .cpc-kicker { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: #7c3aed; margin: 0 0 10px; font-weight: 700; }
  .cpc-hero h1 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); letter-spacing: -.02em; color: #0f172a; margin: 0 0 8px; }
  .cpc-takeaway { font-size: 1.02rem; color: #475569; max-width: 660px; margin: 0; line-height: 1.55; }
  .cpc-takeaway strong { color: #0f172a; }
  .cpc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 0 32px; }
  .cpc-quad { border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px 22px; background: #ffffff; box-shadow: 0 10px 28px -16px rgba(15,23,42,.14); }
  .cpc-quad > span { font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; }
  .q-problem > span { color: #ea580c; }
  .q-approach > span { color: #2563eb; }
  .q-own > span { color: #7c3aed; }
  .q-results > span { color: #059669; }
  .cpc-quad h2 { font-size: 1.12rem; color: #0f172a; letter-spacing: -.01em; margin: 8px 0; }
  .cpc-quad p { font-size: .86rem; line-height: 1.55; color: #475569; margin: 0; }
  .cpc-quad ul { list-style: none; margin: 8px 0 0; padding: 0; }
  .cpc-quad li { font-size: .84rem; line-height: 1.5; color: #475569; padding: 6px 0 6px 18px; position: relative; border-bottom: 1px dashed #e2e8f0; }
  .cpc-quad li:last-child { border-bottom: 0; }
  .cpc-quad li::before { content: "→"; position: absolute; left: 0; color: #7c3aed; font-size: .75rem; }
  .cpc-quad li strong { color: #0f172a; font-weight: 600; }
  .cpc-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .cpc-steps span { font-size: .68rem; padding: 5px 10px; border: 1px solid #bfdbfe; border-radius: 999px; color: #1d4ed8; background: #eff6ff; }
  .cpc-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .cpc-story-video { width: 100%; border-radius: 12px; margin-top: 10px; display: block; background: #0f172a; }
  .cpc-metric { border: 1px solid #a7f3d0; border-radius: 12px; padding: 10px 12px; background: #f0fdf4; }
  .cpc-metric strong { display: block; font-size: 1.35rem; color: #0f172a; }
  .cpc-metric small { font-size: .68rem; color: #64748b; }
  .cpc-metric em { display: block; font-style: normal; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: #059669; margin-top: 2px; }
  .cpc-decisions { margin: 14px 32px 0; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px 22px; background: #ffffff; box-shadow: 0 10px 28px -16px rgba(15,23,42,.14); }
  .cpc-decisions > span { font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; color: #b45309; }
  .cpc-decision-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 12px; }
  .cpc-decision-grid article { display: flex; gap: 10px; }
  .cpc-decision-grid b { font-size: .72rem; color: #b45309; font-weight: 800; }
  .cpc-decision-grid h3 { font-size: .82rem; color: #0f172a; margin: 0 0 4px; }
  .cpc-decision-grid p { font-size: .76rem; color: #475569; line-height: 1.5; margin: 0; }
  .cpc-next { display: flex; justify-content: space-between; align-items: center; margin: 22px 32px 0; padding: 16px 22px; border: 1px solid #e2e8f0; border-radius: 14px; text-decoration: none; background: #ffffff; }
  .cpc-next span { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: #64748b; }
  .cpc-next strong { color: #0f172a; font-size: .95rem; }
  .cpc-next:hover { border-color: #c4b5fd; }
  @media (max-width: 760px) {
    .cpc-grid { grid-template-columns: 1fr; }
    .cpc-decision-grid { grid-template-columns: 1fr 1fr; }
    .cpc-bar, .cpc-hero, .cpc-grid { padding-left: 18px; padding-right: 18px; }
    .cpc-decisions, .cpc-next { margin-left: 18px; margin-right: 18px; }
  }
</style>

<script>
  // Pause the story video for visitors who prefer reduced motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('video.cpc-story-video').forEach((v) => {
      v.removeAttribute('autoplay');
      const vid = v as HTMLVideoElement;
      vid.pause();
    });
  }
</script>
