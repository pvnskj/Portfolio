---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;

const story = {
  problem: 'A typical feature request could spend almost an entire two-week sprint in analysis before development started: about 6 days with business analysts, then another 4 days with developers for technical analysis.',
  goal: 'Create one grounded analysis workflow that brings business context, code, documentation, and historical knowledge together so teams can understand impact faster without removing human validation.',
  ownership: [
    ['Product + build', 'I identified the workflow problem, designed the solution, and personally built the working agent.'],
    ['Knowledge strategy', 'I brought engineering repositories, documentation, shared files, and meeting context into one searchable analysis layer.'],
    ['Analysis experience', 'I designed the agent to investigate, ask follow-up questions, surface dependencies, and return evidence instead of a quick generic answer.'],
    ['Adoption + measurement', 'I introduced it into the analyst workflow and measured success by how quickly work moved from analysis toward development.'],
  ],
  priorities: [
    ['01', 'Solve the biggest delay', 'Focus first on the analysis handoff consuming most of the sprint.'],
    ['02', 'Trust before speed', 'Prioritize grounded evidence and clarification over instant responses.'],
    ['03', 'Unify before expanding', 'Connect the highest-value knowledge sources before adding broader assistant features.'],
  ],
  process: ['Feature intake', 'Agent investigates', 'Clarify gaps', 'Human validation', 'Stories to development'],
  outcomes: [
    ['~10 days → ~6 hrs', 'analysis work', 'Business + technical analysis combined'],
    ['1–2 days', 'story movement', 'Includes human validation and story creation'],
    ['11GB+', 'knowledge corpus', 'Engineering and business knowledge available to the agent'],
    ['558+', 'projects searchable', 'Cross-project impact analysis coverage'],
  ],
  benefits: [
    '~12 analysts supported',
    'Business + technical impact together',
    'Evidence-backed answers',
    'Follow-up questions when context is missing',
    'Human validation retained',
    'Used in the analysis workflow',
  ],
  decisions: [
    ['Accuracy over instant answers', 'The agent can take longer and ask questions when more context is needed.'],
    ['One analysis, not two silos', 'Business and technical impact are assembled together before the developer handoff.'],
    ['Human validation stays', 'Analysts verify the evidence before the output becomes delivery scope.'],
    ['Measure workflow movement', 'Success is how quickly a request moves toward development, not chatbot response speed.'],
  ],
};
---

<section class="eom-compact rag-compact" aria-label="Enterprise RAG Analysis Agent case study">
  <div class="eom-problem-grid">
    <article class="eom-problem-card">
      <span>Business problem</span>
      <h2>Analysis was consuming a sprint</h2>
      <p>{story.problem}</p>
    </article>
    <article class="eom-goal-card">
      <span>Product goal</span>
      <h2>One grounded analysis across business + code.</h2>
      <p>{story.goal}</p>
    </article>
  </div>

  <section class="eom-compact-section" aria-labelledby="rag-owned">
    <div class="eom-section-head"><span>My role</span><h2 id="rag-owned">What I owned</h2></div>
    <div class="eom-card-row">
      {story.ownership.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>

  <section class="eom-compact-section" aria-labelledby="rag-priorities">
    <div class="eom-section-head"><span>Prioritization</span><h2 id="rag-priorities">How I decided what came first</h2></div>
    <div class="eom-priority-row">
      {story.priorities.map(([num,title,text]) => <article><b>{num}</b><div><h3>{title}</h3><p>{text}</p></div></article>)}
    </div>
    <div class="eom-frameworks" aria-label="Frameworks used">
      {project.prioritization.map((item) => <span>{item.title}</span>)}
    </div>
  </section>

  <section class="eom-compact-section eom-process-section" aria-labelledby="rag-process">
    <div class="eom-section-head"><span>Process</span><h2 id="rag-process">From intake to development readiness</h2></div>
    <ol class="rag-process">
      {story.process.map((step,index) => <li><span>{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}
    </ol>
  </section>

  <section class="eom-compact-section" aria-labelledby="rag-result">
    <div class="eom-section-head"><span>Result</span><h2 id="rag-result">What changed with the agent</h2></div>
    <div class="eom-outcome-row">
      {story.outcomes.map(([value,label,detail]) => <article><strong>{value}</strong><h3>{label}</h3><p>{detail}</p></article>)}
    </div>
    <div class="eom-benefit-strip" aria-label="Workflow benefits">
      {story.benefits.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="eom-compact-section" aria-labelledby="rag-decisions">
    <div class="eom-section-head"><span>Product calls</span><h2 id="rag-decisions">Four decisions that shaped the agent</h2></div>
    <div class="eom-decision-carousel">
      {story.decisions.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>
</section>
