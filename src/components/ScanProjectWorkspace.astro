---
import { projects, type Project } from '../data/projects';
import { projectPresentation, getEvidence, publicText } from '../data/projectPresentation';
import ProjectSymbol from './ProjectSymbol.astro';
import RagCompactCase from './RagCompactCase.astro';

interface Props { project: Project; }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const view = projectPresentation[project.slug]!;
const evidence = getEvidence(project);
const proof = evidence[view.proofIndex]!;
const next = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length]!;
const isEom = project.slug === 'enterprise-order-management';
const isRag = project.slug === 'rag-analysis-agent';
const isRfds = project.slug === 'rfds';
const isCompact = isEom || isRag || isRfds;

const eomCompact = {
  problem: 'Our vendor orchestration product charged us per order, so cost grew directly with volume. We chose to build our own platform to remove that dependency, control the roadmap, and introduce intelligent orchestration.',
  goal: 'Build an in-house orchestration platform using a DAG and workers so each order triggers only the tasks it actually needs, reducing vendor dependency while improving control, resilience, and scale.',
  ownership: [
    ['Business case', 'Frame the build-vs-buy opportunity around recurring order cost, control, and scale.'],
    ['Product direction', 'Define the target experience and roadmap for intelligent orchestration.'],
    ['Cross-team delivery', 'Align 19+ teams around shared scope, sequencing, and migration.'],
    ['Outcome validation', 'Protect existing service behavior while proving the new model reduced mapping effort.'],
  ],
  priorities: [
    ['01', 'Protect the business', 'Keep existing service behavior intact during migration.'],
    ['02', 'Remove the dependency', 'Build the reusable orchestration foundation before adding more variation.'],
    ['03', 'Scale what works', 'Move product change toward configuration and measurable operational control.'],
  ],
  process: ['Business case', 'Prioritize low-risk volume', 'Pilot DAG + workers', 'Migrate & measure'],
  decisions: [
    ['Build vs. buy', 'Own the orchestration capability instead of paying indefinitely per order.'],
    ['Start where volume was high', 'Prove the new model on an order type with high throughput but lower business impact before expanding further.'],
    ['Run only what is needed', 'Use the DAG to resolve dependencies and workers to execute only the tasks required for that order.'],
    ['Design for recovery', 'Support validation, SLA control, retry, and reprocessing so failures do not force the entire order to restart.'],
  ],
  outcomes: [
    ['20%', 'faster logic mapping', 'Measured proof-of-concept improvement'],
    ['18', 'service intents', 'Existing behavior protected during migration'],
    ['19+', 'teams aligned', 'Cross-system delivery and migration coordination'],
    ['75K/day', 'target capacity', 'Projected scale for the event-driven model'],
  ],
  benefits: [
    'Only required tasks invoked',
    'Fewer unnecessary downstream calls',
    'Cross-system coordination',
    'Validation before execution',
    'SLA-aware processing',
    'Retry & reprocess support',
  ],
};


const rfdsCompact = {
  problem: 'Critical site-installation diagrams were scattered across local repositories with inconsistent versions and no dependable source of truth. Teams could not always tell whether the latest document matched what was physically installed, which slowed field preparation and contributed to repeat contractor visits and avoidable cost.',
  goal: 'Create one governed workflow that connects site assets, engineering data, field installation, milestones, contractor completion, and payment so current site-specific information is generated from trusted enterprise data when work is actually required.',
  ownership: [
    ['Problem discovery', 'Identify the fragmented-document, versioning, and repeat-visit problem with engineering and field teams.'],
    ['Product direction', 'Reframe the opportunity from document storage into a governed site-engineering and field-operations workflow.'],
    ['Enterprise integration', 'Connect site assets and milestones with RF data, contractor installation activity, and downstream financial processing.'],
    ['Workflow automation', 'Design the milestone-driven path from site update through generation, contractor completion, validation, and payment.'],
  ],
  priorities: [
    ['01', 'Establish one source of truth', 'Solve document fragmentation and version uncertainty before layering on more automation.'],
    ['02', 'Generate from trusted data', 'Use current enterprise asset and engineering data instead of manually maintained document copies.'],
    ['03', 'Trigger work when needed', 'Use the site milestone as the business event that determines when an update is generated and routed.'],
    ['04', 'Close the operational loop', 'Connect contractor completion and milestone validation to downstream payment rather than ending at document generation.'],
  ],
  process: ['Milestone activated', 'Pull current site + RF data', 'Generate installation package', 'Route to contractor', 'Validate completion', 'Trigger payment'],
  outcomes: [
    ['2–4 hrs → <30 sec', 'single-site generation', 'Measured document-generation time per individual site'],
    ['~15 min', 'bulk processing job', 'Automated milestone-driven batch generation for sites requiring updates'],
    ['$1.2M', 'annual cost avoidance', 'Measured production cost avoidance'],
    ['1,000+', 'designs per month', 'Observed operating scale'],
  ],
  benefits: [
    'One governed site record',
    'Version history and current-state visibility',
    'Milestone-driven contractor work',
    'Engineering + field data connected',
    'Bulk processing at network scale',
    'Completion linked to vendor payment',
  ],
  decisions: [
    ['System of record, not another repository', 'Generate and govern site-installation information from enterprise data instead of creating another document store.'],
    ['Generate from data, not copies', 'Treat the document as an output of trusted asset, RF, milestone, and installation information rather than the primary source of truth.'],
    ['Let the milestone drive the workflow', 'Start work when the operational lifecycle shows that a site update is required instead of relying on manual requests.'],
    ['Connect engineering to execution', 'Keep contractor completion, site status, validation, and payment connected to the same workflow.'],
  ],
};


---

<main class="scan-workspace shell" data-project={project.slug} data-tone={view.tone}>
  <nav class="scan-workspace-bar" aria-label="Project navigation">
    <a href={`${base}/#work`}>← Portfolio</a><span>◆ {isEom ? 'ORDER ORCHESTRATION' : isRag ? 'ANALYSIS AGENT' : isRfds ? 'FIELD OPERATIONS' : `EPIC-${project.index}`}</span><a href={`${base}/work/${next.slug}/`}>Next →</a>
  </nav>

  <section class="scan-epic-header" aria-labelledby="project-title">
    <div class="scan-epic-copy">
      <div class="epic-category"><ProjectSymbol slug={project.slug} /><span>{view.group} / {view.role}</span></div>
      <h1 id="project-title">{project.title}</h1>
      <p class="epic-takeaway">{view.before} <span aria-hidden="true">→</span><span class="sr-only">to</span> <strong>{view.after}.</strong></p>
      <p class="epic-contribution"><b>{isCompact ? 'My role' : 'My contribution'}</b>{isEom ? 'Product strategy, prioritization, orchestration roadmap, and cross-team migration.' : isRag ? 'I personally designed and built the analysis agent, integrated the knowledge sources, and introduced it into the analyst workflow.' : isRfds ? 'Problem discovery, product direction, enterprise integration, and milestone-driven field workflow automation.' : view.contribution}</p>
    </div>
    <aside class="scan-primary-proof" aria-label="Headline evidence">
      <span class="proof-type">{proof.type}</span><strong>{proof.value}</strong><span>{proof.label}</span><p>{isEom ? 'Measured in the initial orchestration proof of concept.' : isRag ? 'Business + technical analysis compared with the prior workflow.' : isRfds ? 'Measured per individual site in the automated generation workflow.' : view.proofNote}</p>
      {!isCompact && <a href="#evidence" data-open-evidence>See evidence <span aria-hidden="true">↗</span></a>}
    </aside>
  </section>

  {!isCompact && (
    <section class="scan-evidence-strip" aria-label="More evidence">
      {evidence.filter((_, index) => index !== view.proofIndex).map((metric) => <article><span class="proof-type">{metric.type}</span><strong>{metric.value}</strong><span>{metric.label}</span></article>)}
    </section>
  )}

  {isEom ? (
    <section class="eom-compact" aria-label="Enterprise Order Management case study">
      <div class="eom-problem-grid">
        <article class="eom-problem-card">
          <span>Business problem</span>
          <h2>Why build our own?</h2>
          <p>{eomCompact.problem}</p>
        </article>
        <article class="eom-goal-card">
          <span>Product goal</span>
          <h2>Lower cost. More control. Smarter fulfillment.</h2>
          <p>{eomCompact.goal}</p>
        </article>
      </div>

      <section class="eom-compact-section" aria-labelledby="eom-owned">
        <div class="eom-section-head"><span>My role</span><h2 id="eom-owned">What I owned</h2></div>
        <div class="eom-card-row">
          {eomCompact.ownership.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>

      <section class="eom-compact-section" aria-labelledby="eom-priorities">
        <div class="eom-section-head"><span>Prioritization</span><h2 id="eom-priorities">How I decided what came first</h2></div>
        <div class="eom-priority-row">
          {eomCompact.priorities.map(([num, title, text]) => <article><b>{num}</b><div><h3>{title}</h3><p>{text}</p></div></article>)}
        </div>
        <div class="eom-frameworks" aria-label="Frameworks used">
          {project.prioritization.map((item) => <span>{item.title}</span>)}
        </div>
      </section>

      <section class="eom-compact-section eom-process-section" aria-labelledby="eom-process">
        <div class="eom-section-head"><span>Process</span><h2 id="eom-process">From constraint to product</h2></div>
        <ol class="eom-process">
          {eomCompact.process.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
        </ol>
      </section>

      <section class="eom-compact-section" aria-labelledby="eom-result">
        <div class="eom-section-head"><span>Result</span><h2 id="eom-result">What the new orchestration changed</h2></div>
        <div class="eom-outcome-row">
          {eomCompact.outcomes.map(([value, label, detail]) => <article><strong>{value}</strong><h3>{label}</h3><p>{detail}</p></article>)}
        </div>
        <div class="eom-benefit-strip" aria-label="Operational benefits">
          {eomCompact.benefits.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="eom-compact-section" aria-labelledby="eom-decisions">
        <div class="eom-section-head"><span>Product calls</span><h2 id="eom-decisions">Four decisions that shaped the product</h2></div>
        <div class="eom-decision-carousel">
          {eomCompact.decisions.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>
    </section>
  ) : isRag ? (
    <RagCompactCase project={project} />
  ) : isRfds ? (
    <section class="eom-compact" aria-label="Site Engineering and Field Operations case study">
      <div class="eom-problem-grid">
        <article class="eom-problem-card">
          <span>Business problem</span>
          <h2>Field work was running on fragmented information.</h2>
          <p>{rfdsCompact.problem}</p>
        </article>
        <article class="eom-goal-card">
          <span>Product goal</span>
          <h2>One governed path from site change to field completion.</h2>
          <p>{rfdsCompact.goal}</p>
        </article>
      </div>

      <section class="eom-compact-section" aria-labelledby="rfds-owned">
        <div class="eom-section-head"><span>My role</span><h2 id="rfds-owned">What I owned</h2></div>
        <div class="eom-card-row">
          {rfdsCompact.ownership.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>

      <section class="eom-compact-section" aria-labelledby="rfds-priorities">
        <div class="eom-section-head"><span>Prioritization</span><h2 id="rfds-priorities">How I decided what came first</h2></div>
        <div class="eom-priority-row">
          {rfdsCompact.priorities.map(([num, title, text]) => <article><b>{num}</b><div><h3>{title}</h3><p>{text}</p></div></article>)}
        </div>
        <div class="eom-frameworks" aria-label="Frameworks used">
          {project.prioritization.map((item) => <span>{item.title}</span>)}
        </div>
      </section>

      <section class="eom-compact-section eom-process-section" aria-labelledby="rfds-process">
        <div class="eom-section-head"><span>Process</span><h2 id="rfds-process">From site milestone to field execution</h2></div>
        <ol class="rfds-process">
          {rfdsCompact.process.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
        </ol>
      </section>

      <section class="eom-compact-section" aria-labelledby="rfds-result">
        <div class="eom-section-head"><span>Result</span><h2 id="rfds-result">What the workflow changed</h2></div>
        <div class="eom-outcome-row">
          {rfdsCompact.outcomes.map(([value, label, detail]) => <article><strong>{value}</strong><h3>{label}</h3><p>{detail}</p></article>)}
        </div>
        <div class="eom-benefit-strip" aria-label="Operational impact">
          {rfdsCompact.benefits.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="eom-compact-section" aria-labelledby="rfds-decisions">
        <div class="eom-section-head"><span>Product calls</span><h2 id="rfds-decisions">Four decisions that shaped the product</h2></div>
        <div class="eom-decision-carousel">
          {rfdsCompact.decisions.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>
    </section>
  ) : (
<>
  <section class="scan-story" aria-label="Project at a glance">
    <article><h2>Problem</h2><p>{view.problem}</p></article>
    <article class="scan-decision"><h2>My decision</h2><p>{view.decision}</p></article>
    <article><h2>What changed</h2><p>{view.outcome}</p></article>
  </section>

  <section class="scan-flow" aria-labelledby="flow-title">
    <h2 id="flow-title">How it works</h2>
    <ol>{view.flow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}</ol>
  </section>

  <section class="scan-detail-section" aria-labelledby="details-title">
    <div class="scan-detail-heading"><h2 id="details-title">Inside the work</h2><span>Explore on this page</span></div>
    <div class="scan-feature-list">
      {project.increments.map((increment, index) => (
        <details class="scan-feature" name="project-detail">
          <summary><span class="issue-key">FOCUS-{String(index + 1).padStart(2, '0')}</span><h3>{publicText(increment.title)}</h3><span class="disclosure-plus" aria-hidden="true">+</span></summary>
          <div class="scan-feature-content">
            <div class="scan-detail-pair"><div><h4>Focus</h4><p>{publicText(increment.focus)}</p></div><div><h4>Question to resolve</h4><p>{publicText(increment.learning)}</p></div></div>
          </div>
        </details>
      ))}

      <details class="scan-record" name="project-detail">
        <summary><span class="record-symbol" aria-hidden="true">◇</span><h3>Decisions & trade-offs</h3><span class="disclosure-plus" aria-hidden="true">+</span></summary>
        <div class="scan-record-content">
          {project.decisions.map((decision, index) => <article class="scan-decision-row"><span>{String(index + 1).padStart(2, '0')}</span><div><h4>{publicText(decision.title)}</h4><p>{publicText(decision.body)}</p></div></article>)}
        </div>
      </details>

      <details class="scan-record" name="project-detail">
        <summary><span class="record-symbol" aria-hidden="true">◈</span><h3>Prioritization frameworks</h3><span class="disclosure-plus" aria-hidden="true">+</span></summary>
        <div class="scan-record-content">
          {project.prioritization.map((framework, index) => <article class="scan-decision-row"><span>{String(index + 1).padStart(2, '0')}</span><div><h4>{framework.title}</h4><p>{publicText(framework.body)}</p></div></article>)}
        </div>
      </details>

      <details class="scan-record" name="project-detail">
        <summary><span class="record-symbol" aria-hidden="true">◎</span><h3>Ownership & system context</h3><span class="disclosure-plus" aria-hidden="true">+</span></summary>
        <div class="scan-record-content">
          <p>{publicText(project.summary)}</p>
          <div class="scan-detail-pair"><div><h4>What I owned</h4><ul>{project.ownership.map((item) => <li>{publicText(item)}</li>)}</ul></div><div><h4>What made it hard</h4><ul>{project.complexity.map((item) => <li>{publicText(item)}</li>)}</ul></div></div>
          <h4>Business constraint</h4><p>{publicText(project.problem)}</p>
          <h4>Product goal</h4><p>{publicText(project.productGoal)}</p>
          <h4>System flow</h4><ol class="scan-full-flow">{project.flow.map((step) => <li>{publicText(step)}</li>)}</ol>
          <p>{publicText(project.flowCaption)}</p>
        </div>
      </details>

      <details id="evidence" class="scan-record" name="project-detail">
        <summary><span class="record-symbol" aria-hidden="true">↗</span><h3>Evidence & measurement basis</h3><span class="disclosure-plus" aria-hidden="true">+</span></summary>
        <div class="scan-record-content">
          {evidence.map((metric) => <article class="scan-evidence-row"><div><span class="proof-type">{metric.type}</span><strong>{metric.value}</strong><h4>{metric.label}</h4></div><p>{metric.detail}</p></article>)}
          <p class="scan-evidence-context">{publicText(project.valueNarrative)}</p>
        </div>
      </details>
    </div>
  </section>
</>
  )}

  <a class="scan-next-project" href={`${base}/work/${next.slug}/`}><span>Next project</span><strong>{next.title}</strong><b aria-hidden="true">→</b></a>
</main>

<script>
  function bindEvidenceLink() {
    const workspace = document.querySelector<HTMLElement>('.scan-workspace');
    if (!workspace || workspace.dataset.bound === 'true') return;
    workspace.dataset.bound = 'true';
    const evidence = workspace.querySelector<HTMLDetailsElement>('#evidence');
    const evidenceLink = workspace.querySelector('[data-open-evidence]');
    if (!evidence || !evidenceLink) return;
    const openEvidence = () => { if (window.location.hash === '#evidence') evidence.open = true; };
    evidenceLink.addEventListener('click', () => { evidence.open = true; });
    window.addEventListener('hashchange', openEvidence);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('hashchange', openEvidence), { once: true });
    openEvidence();
  }
  bindEvidenceLink();
  document.addEventListener('astro:page-load', bindEvidenceLink);
</script>
