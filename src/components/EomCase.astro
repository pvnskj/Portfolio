---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ownership = [
  ['Business case', 'Build vs. buy, cost, control, scale.'],
  ['Product direction', 'Target model and migration roadmap.'],
  ['Cross-team delivery', '19+ teams, shared sequencing and dependencies.'],
  ['Outcome validation', 'Protect behavior while proving the new model.'],
];
const flow = ['Business case', 'Low-risk pilot', 'DAG + workers', 'Migrate & measure'];
const outcomes = [
  ['20%', 'Faster logic mapping', 'Measured'],
  ['19+', 'Teams coordinated', 'Actual'],
  ['18', 'Service intents in scope', 'Actual'],
  ['75K/day', 'Target order capacity', 'Projected'],
];
const decisions = [
  ['Dependencies over diagrams', 'Capabilities declare what they require and execute; the platform resolves sequence and parallelism.'],
  ['Assess before execution', 'Decomposition, identifiers, and enrichment resolve before fulfillment begins.'],
  ['One shared order context', 'A governed lifecycle context prevents divergent versions of the same order.'],
  ['Configuration over customization', 'Policy moves to governed configuration while the execution model stays stable.'],
];
---

<main class="eomc-page shell">
  <nav class="eomc-bar" aria-label="Project navigation">
    <a href={`${base}/#work`}>← Portfolio</a>
    <b>Enterprise Order Management</b>
    <a href={`${base}/work/rag-analysis-agent/`}>Next →</a>
  </nav>

  <header class="eomc-hero">
    <p class="eomc-kicker">Platform · Order orchestration</p>
    <h1>Enterprise Order Management</h1>
    <p class="eomc-takeaway">Reducing vendor dependency through <strong>intelligent orchestration</strong> — new services launch without remodeling every fulfillment path.</p>
  </header>

  <div class="eomc-grid">
    <section class="eomc-quad q-problem">
      <span>Problem</span>
      <h2>Vendor dependency was scaling with every order.</h2>
      <p>Per-order vendor cost increased with volume and limited roadmap control. Every new plan, add-on, or service combination forced teams to revisit the fulfillment flow.</p>
    </section>

    <section class="eomc-quad q-approach">
      <span>Approach</span>
      <h2>Dependencies over diagrams.</h2>
      <p>Capabilities declare what they require and what they can execute; the platform resolves sequence and parallelism instead of manually redrawing every product path.</p>
      <div class="eomc-steps">{flow.map((step) => <span>{step}</span>)}</div>
    </section>

    <section class="eomc-quad q-own">
      <span>Ownership</span>
      <h2>What I owned</h2>
      <ul>
        {ownership.map(([title, text]) => <li><strong>{title}</strong> — {text}</li>)}
      </ul>
    </section>

    <section class="eomc-quad q-results">
      <span>Results</span>
      <h2>Measured outcomes</h2>
      <div class="eomc-metrics">
        {outcomes.map(([value, label, type]) => (
          <div class="eomc-metric"><strong>{value}</strong><small>{label}</small><em>{type}</em></div>
        ))}
      </div>
    </section>
  </div>

  <section class="eomc-decisions" aria-label="Key decisions">
    <span>Judgment calls</span>
    <div class="eomc-decision-grid">
      {decisions.map(([title, text], i) => (
        <article><b>{String(i + 1).padStart(2, '0')}</b><div><h3>{title}</h3><p>{text}</p></div></article>
      ))}
    </div>
  </section>

  <a class="eomc-next" href={`${base}/work/rag-analysis-agent/`}><span>Next project</span><strong>Enterprise RAG Analysis Agent →</strong></a>
</main>

<style>
  .eomc-page { max-width: 1200px; margin: 0 auto; padding-bottom: 48px; }
  .eomc-bar { display: flex; justify-content: space-between; align-items: center; padding: 14px 32px; border-bottom: 1px solid #e2e8f0; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: #64748b; }
  .eomc-bar a { color: #64748b; text-decoration: none; }
  .eomc-bar a:hover { color: #0f172a; }
  .eomc-bar b { color: #334155; font-weight: 700; }
  .eomc-hero { padding: 34px 32px 20px; }
  .eomc-kicker { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: #7c3aed; margin: 0 0 10px; font-weight: 700; }
  .eomc-hero h1 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); letter-spacing: -.02em; color: #0f172a; margin: 0 0 8px; }
  .eomc-takeaway { font-size: 1.02rem; color: #475569; max-width: 660px; margin: 0; line-height: 1.55; }
  .eomc-takeaway strong { color: #0f172a; }
  .eomc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 0 32px; }
  .eomc-quad { border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px 22px; background: linear-gradient(160deg, #0f172afff, #0f172afff); }
  .eomc-quad > span { font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; }
  .q-problem > span { color: #ea580c; }
  .q-approach > span { color: #2563eb; }
  .q-own > span { color: #7c3aed; }
  .q-results > span { color: #059669; }
  .eomc-quad h2 { font-size: 1.12rem; color: #0f172a; letter-spacing: -.01em; margin: 8px 0; }
  .eomc-quad p { font-size: .86rem; line-height: 1.55; color: #475569; margin: 0; }
  .eomc-quad ul { list-style: none; margin: 8px 0 0; padding: 0; }
  .eomc-quad li { font-size: .84rem; line-height: 1.5; color: #475569; padding: 6px 0 6px 18px; position: relative; border-bottom: 1px dashed #e2e8f0; }
  .eomc-quad li:last-child { border-bottom: 0; }
  .eomc-quad li::before { content: "→"; position: absolute; left: 0; color: #7c3aed; font-size: .75rem; }
  .eomc-quad li strong { color: #0f172a; font-weight: 600; }
  .eomc-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .eomc-steps span { font-size: .68rem; padding: 5px 10px; border: 1px solid #bfdbfe; border-radius: 999px; color: #1d4ed8; background: #eff6ff; }
  .eomc-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .eomc-metric { border: 1px solid #a7f3d0; border-radius: 12px; padding: 10px 12px; background: #f0fdf4; }
  .eomc-metric strong { display: block; font-size: 1.35rem; color: #0f172a; }
  .eomc-metric small { font-size: .68rem; color: #64748b; }
  .eomc-metric em { display: block; font-style: normal; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: #059669; margin-top: 2px; }
  .eomc-decisions { margin: 14px 32px 0; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px 22px; background: linear-gradient(160deg, #0f172afff, #0f172afff); }
  .eomc-decisions > span { font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; color: #b45309; }
  .eomc-decision-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 12px; }
  .eomc-decision-grid article { display: flex; gap: 10px; }
  .eomc-decision-grid b { font-size: .72rem; color: #b45309; font-weight: 800; }
  .eomc-decision-grid h3 { font-size: .82rem; color: #0f172a; margin: 0 0 4px; }
  .eomc-decision-grid p { font-size: .76rem; color: #475569; line-height: 1.5; margin: 0; }
  .eomc-next { display: flex; justify-content: space-between; align-items: center; margin: 22px 32px 0; padding: 16px 22px; border: 1px solid #e2e8f0; border-radius: 14px; text-decoration: none; background: #0f172afff; }  .eomc-next span { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: #64748b; }
  .eomc-next strong { color: #0f172a; font-size: .95rem; }
  .eomc-next:hover { border-color: #c4b5fd; }
  @media (max-width: 760px) {
    .eomc-grid { grid-template-columns: 1fr; }
    .eomc-decision-grid { grid-template-columns: 1fr 1fr; }
    .eomc-bar, .eomc-hero, .eomc-grid { padding-left: 18px; padding-right: 18px; }
    .eomc-decisions, .eomc-next { margin-left: 18px; margin-right: 18px; }
  }
</style>
