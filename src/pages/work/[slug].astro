---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScanProjectWorkspace from '../../components/ScanProjectWorkspace.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Venkata Parimi`}
  description={`${project.question} ${project.productGoal}`}
  bareMain
  bodyClass={project.slug === 'enterprise-order-management' ? 'portfolio-dark' : ''}
>
  <ScanProjectWorkspace project={project} />
</BaseLayout>
