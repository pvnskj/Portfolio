---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSymbol from '../components/ProjectSymbol.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    slug: 'enterprise-order-management',
    title: 'Enterprise Order Management',
    group: 'Platform',
    tone: 'blue',
    summary: 'Intelligent orchestration for enterprise order flows.',
    visual: 'orchestration',
  },
  {
    slug: 'rag-analysis-agent',
    title: 'Enterprise RAG Analysis Agent',
    group: 'AI',
    tone: 'violet',
    summary: 'Grounded analysis across fragmented enterprise knowledge.',
    visual: 'rag',
  },
  {
    slug: 'build-plus',
    title: 'Build Plus',
    group: 'Operations',
    tone: 'teal',
    summary: 'Product + engineering for supply-chain operations.',
    visual: 'build',
  },
  {
    slug: 'rfds',
    title: 'Site Engineering & Field Operations',
    group: 'Operations',
    tone: 'cyan',
    summary: 'Field execution tied to governed site information.',
    visual: 'field',
  },
  {
    slug: 'gl-coding',
    title: 'Dynamic GL Coding',
    group: 'Finance',
    tone: 'amber',
    summary: 'Configurable financial routing across business units.',
    visual: 'finance',
  },
  {
    slug: 'lease-vendor-management',
    title: 'Lease & Vendor Management',
    group: 'Finance',
    tone: 'rose',
    summary: 'Vendor, lease, and payment controls at scale.',
    visual: 'lease',
  },
];

const metrics = [
  ['19+', 'Teams'],
  ['558+', 'Projects'],
  ['$1.2M', 'Cost avoided'],
  ['1,000+', 'Designs / mo'],
];
---

<BaseLayout bodyClass="portfolio-dark">
  <div class="concept-b shell">
    <section class="concept-b-hero" aria-labelledby="portfolio-title">
      <div class="concept-b-hero-copy">
        <p class="concept-b-kicker">Enterprise systems × AI × execution</p>
        <h1 id="portfolio-title">
          Complex systems.<br />
          Clear direction.<br />
          <span>Real impact.</span>
        </h1>
        <p class="concept-b-subhead">
          I’m Venkata Parimi, a Senior Technical Product Owner who turns ambiguity into product decisions and measurable outcomes.
        </p>
        <div class="concept-b-actions">
          <a class="concept-b-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a>
          <a class="concept-b-secondary" href="#approach">How I work</a>
        </div>

        <div class="concept-b-metrics" aria-label="Portfolio highlights">
          {metrics.map(([value, label]) => (
            <div><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>

      <div class="concept-b-visual" aria-hidden="true">
        <div class="concept-b-wave"></div>
        <div class="system-visual">
                  <div class="signal-stage" aria-hidden="true">
                    <span class="signal-word" style="--x:15%;--y:9%;--r:-6deg;--delay:0s">Requirements</span>
                    <span class="signal-word" style="--x:45%;--y:10%;--r:3deg;--delay:.08s">Customer needs</span>
                    <span class="signal-word" style="--x:80%;--y:9%;--r:-3deg;--delay:.16s">Product vision</span>
                    <span class="signal-word" style="--x:11%;--y:21%;--r:5deg;--delay:.24s">Roadmap</span>
                    <span class="signal-word" style="--x:35%;--y:21%;--r:-4deg;--delay:.32s">Prioritization</span>
                    <span class="signal-word" style="--x:61%;--y:21%;--r:5deg;--delay:.4s">Backlog</span>
                    <span class="signal-word" style="--x:86%;--y:21%;--r:-5deg;--delay:.48s">Value</span>
                    <span class="signal-word" style="--x:13%;--y:33%;--r:-4deg;--delay:.56s">Discovery</span>
                    <span class="signal-word" style="--x:39%;--y:33%;--r:4deg;--delay:.64s">User stories</span>
                    <span class="signal-word" style="--x:76%;--y:33%;--r:-3deg;--delay:.72s">Stakeholder alignment</span>
                    <span class="signal-word" style="--x:13%;--y:45%;--r:5deg;--delay:.8s">Trade-offs</span>
                    <span class="signal-word" style="--x:41%;--y:45%;--r:-3deg;--delay:.88s">Dependencies</span>
                    <span class="signal-word" style="--x:65%;--y:45%;--r:5deg;--delay:.96s">Risks</span>
                    <span class="signal-word" style="--x:86%;--y:45%;--r:-4deg;--delay:1.04s">Constraints</span>
                    <span class="signal-word" style="--x:20%;--y:57%;--r:-5deg;--delay:1.12s">Acceptance criteria</span>
                    <span class="signal-word" style="--x:54%;--y:57%;--r:4deg;--delay:1.2s">Sprint goals</span>
                    <span class="signal-word" style="--x:83%;--y:57%;--r:-3deg;--delay:1.28s">Architecture</span>
                    <span class="signal-word" style="--x:14%;--y:69%;--r:4deg;--delay:1.36s">Development</span>
                    <span class="signal-word" style="--x:41%;--y:69%;--r:-5deg;--delay:1.44s">QA &amp; testing</span>
                    <span class="signal-word" style="--x:76%;--y:69%;--r:3deg;--delay:1.52s">Release planning</span>
                    <span class="signal-word" style="--x:11%;--y:81%;--r:-4deg;--delay:1.6s">Rollout</span>
                    <span class="signal-word" style="--x:36%;--y:81%;--r:3deg;--delay:1.68s">Communication</span>
                    <span class="signal-word" style="--x:65%;--y:81%;--r:-5deg;--delay:1.76s">Feedback</span>
                    <span class="signal-word" style="--x:88%;--y:81%;--r:4deg;--delay:1.84s">Adoption</span>
                    <span class="signal-word" style="--x:14%;--y:92%;--r:4deg;--delay:1.92s">Analytics</span>
                    <span class="signal-word" style="--x:38%;--y:92%;--r:-4deg;--delay:2s">Metrics</span>
                    <span class="signal-word" style="--x:61%;--y:92%;--r:3deg;--delay:2.08s">AI</span>
                    <span class="signal-word" style="--x:84%;--y:92%;--r:-3deg;--delay:2.16s">Governance</span>
                    <span class="signal-core"></span>
                    <div class="signal-framework">
                      <div class="signal-layer">
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v3m10 7h-3M5 12H2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                        <div><strong>Strategy</strong><small>Turn vision into focused opportunities</small></div><em>01</em>
                      </div>
                      <div class="signal-layer">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M8 3a4 4 0 0 0-3 6.65A4.5 4.5 0 0 0 7 18h1m8-15a4 4 0 0 1 3 6.65A4.5 4.5 0 0 1 17 18h-1M8 7h8M7 12h10M9 17h6M10 3v18m4-18v18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <div><strong>AI Intelligence</strong><small>Augment decisions with data and AI</small></div><em>02</em>
                      </div>
                      <div class="signal-layer">
                        <svg viewBox="0 0 24 24" fill="none"><path d="m4 7 8-4 8 4-8 4-8-4Z" stroke="currentColor" stroke-width="1.6"/><path d="M4 7v10l8 4 8-4V7M12 11v10" stroke="currentColor" stroke-width="1.6"/></svg>
                        <div><strong>Product Execution</strong><small>Ship scalable, real-world solutions</small></div><em>03</em>
                      </div>
                      <div class="signal-layer">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 20V10m6 10V5m6 15v-7m4 7H2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="m4 7 5-4 5 5 6-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <div><strong>Measurable Outcomes</strong><small>Drive efficiency, adoption, and impact</small></div><em>04</em>
                      </div>
                    </div>
                    <span class="signal-caption">Complexity, resolved.</span>
                  </div>
                </div>
        <div class="concept-b-annotation">
          <i></i>
          <span>From complexity<br />to clarity</span>
        </div>
      </div>
    </section>

    <section id="work" class="concept-b-work" aria-labelledby="work-title">
      <div class="concept-b-section-head">
        <div>
          <p>Selected product work</p>
          <h2 id="work-title">Six products. Different problems. Same product discipline.</h2>
        </div>
        <span>From systems scale to measurable business impact.</span>
      </div>

      <div class="concept-b-project-grid">
        {projects.map((project, index) => (
          <a
            class="concept-b-project"
            data-tone={project.tone}
            href={`${base}/work/${project.slug}/`}
            aria-label={`Open ${project.title} case study`}
          >
            <div class="concept-b-project-visual">
              <div class={`approved-project-snip snip-${project.visual}`} aria-hidden="true"></div>
              <div class="concept-b-project-number">0{index + 1}</div>
              <div class="concept-b-project-symbol"><ProjectSymbol slug={project.slug} /></div>
            </div>
            <div class="concept-b-project-copy">
              <span>{project.group}</span>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <b aria-hidden="true">↗</b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="approach" class="concept-b-bottom-grid" aria-label="Product leadership approach">
      <article class="concept-b-panel">
        <div class="concept-b-panel-icon" aria-hidden="true">◫</div>
        <div>
          <p class="concept-b-panel-kicker">How I work</p>
          <h2>Find the real problem. Make the trade-off visible. Prove before scaling.</h2>
          <div class="concept-b-tags">
            <span>Systems thinking</span>
            <span>Customer focus</span>
            <span>Cross-functional execution</span>
          </div>
        </div>
        <a href="#work" aria-label="View product work">→</a>
      </article>

      <article class="concept-b-panel concept-b-panel-ai">
        <div class="concept-b-panel-icon" aria-hidden="true">✦</div>
        <div>
          <p class="concept-b-panel-kicker">How AI changed my work</p>
          <h2>Less coordination overhead. More time for product judgment.</h2>
          <div class="concept-b-transform">
            <span>Research</span><b>→</b><span>Synthesize</span><b>→</b><span>Decide</span>
          </div>
        </div>
        <span class="concept-b-panel-arrow" aria-hidden="true">→</span>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
.system-visual {
  --blue: #4b7cff;
  --cyan: #47dfec;
  --violet: #8d54ff;
  --orange: #ffae67;
  --faint: #707b92;
}


    .system-visual { position: relative; min-height: 460px; perspective: 1100px; }

    .system-visual::after { content: ""; position: absolute; left: 5%; right: 4%; bottom: 3%; height: 18%; background: radial-gradient(ellipse, rgba(80, 72, 255, .5), transparent 68%); filter: blur(24px); opacity: .7; }


    .system-visual { filter: drop-shadow(0 24px 35px rgba(0,0,0,.42)); }

    .system-visual::before {
      content: "";
      position: absolute;
      inset: 5% -4% 1% -8%;
      background: radial-gradient(ellipse at center, rgba(78, 50, 217, .34), transparent 63%);
      filter: blur(13px);
      pointer-events: none;
    }


    /* The hero turns the noise of product work into a clear operating system. */
    .signal-stage {
      position: absolute;
      inset: 18px 0 8px;
      overflow: hidden;
      border: 1px solid rgba(126, 151, 224, .16);
      border-radius: 28px;
      background:
        linear-gradient(rgba(98, 128, 203, .055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(98, 128, 203, .055) 1px, transparent 1px),
        radial-gradient(circle at 50% 50%, rgba(80, 87, 255, .16), transparent 42%),
        rgba(4, 8, 19, .5);
      background-size: 34px 34px, 34px 34px, auto, auto;
      mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    }

    .signal-stage::before,
    .signal-stage::after {
      content: "";
      position: absolute;
      inset: 50% auto auto 50%;
      width: 104px;
      height: 104px;
      border: 1px solid rgba(90, 133, 255, .22);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(.2);
      opacity: 0;
      animation: signalEcho 12s ease-out infinite;
    }

    .signal-stage::after { animation-delay: .42s; }

    .signal-word {
      position: absolute;
      left: var(--x);
      top: var(--y);
      z-index: 2;
      padding: 5px 9px;
      border: 1px solid color-mix(in srgb, var(--word-tone, var(--blue)) 42%, transparent);
      border-radius: 999px;
      background: rgba(7, 13, 29, .78);
      color: color-mix(in srgb, var(--word-tone, var(--blue)) 70%, white 30%);
      box-shadow: 0 0 16px color-mix(in srgb, var(--word-tone, var(--blue)) 15%, transparent);
      font-size: clamp(.5rem, .62vw, .64rem);
      font-weight: 700;
      white-space: nowrap;
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--r)) scale(.82);
      animation: gatherSignal 12s cubic-bezier(.55, .05, .25, 1) infinite;
      animation-delay: calc(var(--delay) - 2s);
    }

    .signal-word:nth-child(3n) { --word-tone: var(--cyan); }

    .signal-word:nth-child(3n + 2) { --word-tone: var(--violet); }

    .signal-core {
      position: absolute;
      z-index: 3;
      left: 50%;
      top: 50%;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #d9e5ff;
      box-shadow: 0 0 16px #6b8fff, 0 0 44px rgba(92, 91, 255, .85);
      opacity: 0;
      transform: translate(-50%, -50%) scale(.3);
      animation: coreResolve 12s ease-in-out infinite;
    }

    .signal-framework {
      position: absolute;
      z-index: 4;
      inset: 35px 36px 31px 36px;
      display: grid;
      grid-template-rows: repeat(4, 1fr);
      gap: 9px;
      pointer-events: none;
    }

    .signal-layer {
      --tone: var(--blue);
      display: grid;
      grid-template-columns: 34px 1fr auto;
      align-items: center;
      gap: 12px;
      min-height: 0;
      padding: 10px 15px;
      border: 1px solid color-mix(in srgb, var(--tone) 62%, white 9%);
      border-radius: 12px;
      background: linear-gradient(105deg, color-mix(in srgb, var(--tone) 22%, #0c162b), rgba(6, 11, 25, .94) 64%);
      box-shadow: 0 12px 28px rgba(0,0,0,.27), 0 0 18px color-mix(in srgb, var(--tone) 17%, transparent), inset 0 0 24px color-mix(in srgb, var(--tone) 9%, transparent);
      opacity: 0;
      transform: translateX(28px) scale(.97);
      animation: frameworkResolve 12s cubic-bezier(.2, .75, .2, 1) infinite;
      animation-delay: var(--layer-delay);
    }

    .signal-layer:nth-child(1) { --tone: var(--violet); --layer-delay: 0s; }

    .signal-layer:nth-child(2) { --tone: var(--blue); --layer-delay: .16s; }

    .signal-layer:nth-child(3) { --tone: var(--cyan); --layer-delay: .32s; }

    .signal-layer:nth-child(4) { --tone: var(--orange); --layer-delay: .48s; }

    .signal-layer svg { width: 25px; color: var(--tone); filter: drop-shadow(0 0 8px currentColor); }

    .signal-layer strong { display: block; color: #fff; font-family: Sora, sans-serif; font-size: clamp(.78rem, 1vw, .94rem); letter-spacing: -.02em; }

    .signal-layer small { display: block; margin-top: 1px; color: #9aa7c1; font-size: clamp(.48rem, .6vw, .59rem); }

    .signal-layer em { color: color-mix(in srgb, var(--tone) 72%, white 28%); font-size: .52rem; font-style: normal; font-weight: 800; letter-spacing: .09em; }

    .signal-caption {
      position: absolute;
      z-index: 5;
      left: 50%;
      bottom: 7px;
      color: var(--faint);
      font-size: .56rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(-50%);
      animation: captionCycle 12s ease infinite;
    }

      .system-visual { min-height: 390px; margin-top: 30px; }

      .signal-word, .signal-core, .signal-stage::before, .signal-stage::after, .signal-caption { display: none; }

      .signal-layer { opacity: 1; transform: none; animation: none !important; }
@keyframes gatherSignal {
      0%, 31% { left: var(--x); top: var(--y); opacity: .92; transform: translate(-50%, -50%) rotate(var(--r)) scale(1); }
      38% { left: var(--x); top: var(--y); opacity: 1; transform: translate(-50%, -50%) rotate(0) scale(1.04); }
      51% { left: 50%; top: 50%; opacity: .78; transform: translate(-50%, -50%) rotate(0) scale(.58); }
      57%, 100% { left: 50%; top: 50%; opacity: 0; transform: translate(-50%, -50%) rotate(0) scale(.25); }
    }
@keyframes signalEcho {
      0%, 43% { opacity: 0; transform: translate(-50%, -50%) scale(.15); }
      48% { opacity: .8; }
      63%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(4.5); }
    }
@keyframes coreResolve {
      0%, 42% { opacity: 0; transform: translate(-50%, -50%) scale(.3); }
      49% { opacity: 1; transform: translate(-50%, -50%) scale(1.65); }
      58% { opacity: .9; transform: translate(-50%, -50%) scale(1); }
      65%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(.45); }
    }
@keyframes frameworkResolve {
      0%, 52% { opacity: 0; transform: translateX(28px) scale(.97); }
      60%, 89% { opacity: 1; transform: translateX(0) scale(1); }
      96%, 100% { opacity: 0; transform: translateX(-10px) scale(.99); }
    }
@keyframes captionCycle {
      0%, 11%, 91%, 100% { opacity: 0; }
      16%, 43% { opacity: 1; content: ""; }
      55%, 86% { opacity: .72; }
    }
@media (prefers-reduced-motion: reduce) {
  .system-visual .signal-word,
  .system-visual .signal-core,
  .system-visual .signal-stage::before,
  .system-visual .signal-stage::after,
  .system-visual .signal-caption { display: none; }
  .system-visual .signal-layer { opacity: 1; transform: none; animation: none !important; }
}

</style>
