---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSymbol from '../components/ProjectSymbol.astro';
import '../styles/home-light.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    slug: 'enterprise-order-management',
    title: 'Enterprise Order Management',
    group: 'Platform',
    tone: 'blue',
    summary: 'Intelligent orchestration for enterprise order flows.',
    visual: 'orchestration',
  },
  {
    slug: 'rag-analysis-agent',
    title: 'Enterprise RAG Analysis Agent',
    group: 'AI',
    tone: 'violet',
    summary: 'Grounded analysis across fragmented enterprise knowledge.',
    visual: 'rag',
  },
  {
    slug: 'build-plus',
    title: 'Build Plus',
    group: 'Operations',
    tone: 'teal',
    summary: 'Product + engineering for supply-chain operations.',
    visual: 'build',
  },
  {
    slug: 'rfds',
    title: 'Site Engineering & Field Operations',
    group: 'Operations',
    tone: 'cyan',
    summary: 'Field execution tied to governed site information.',
    visual: 'field',
  },
  {
    slug: 'gl-coding',
    title: 'Dynamic GL Coding',
    group: 'Accounting',
    tone: 'amber',
    summary: 'Configurable financial routing across business units.',
    visual: 'finance',
  },
  {
    slug: 'lease-vendor-management',
    title: 'Lease & Vendor Management',
    group: 'Finance',
    tone: 'rose',
    summary: 'Vendor, lease, and payment controls at scale.',
    visual: 'lease',
  },
];

const metrics = [
  ['19+', 'Teams'],
  ['558+', 'Projects'],
  ['$1.2M', 'Cost avoided'],
  ['1,000+', 'Designs / mo'],
];
---

<BaseLayout bodyClass="portfolio-light">
  <div class="concept-b shell">
    <section class="concept-b-hero" aria-labelledby="portfolio-title">
      <div class="concept-b-hero-copy">
        <p class="concept-b-kicker">Enterprise systems × AI × execution</p>
        <h1 id="portfolio-title">
          Complex systems.<br />
          Clear direction.<br />
          <span>Real impact.</span>
        </h1>
        <p class="concept-b-subhead">
          I’m Venkata Parimi — I turn ambiguous enterprise problems into shipped products with measurable outcomes.
        </p>
        <div class="concept-b-actions">
          <a class="concept-b-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a>
          <a class="concept-b-secondary" href="#approach">How I work</a>
        </div>

        <div class="concept-b-metrics" aria-label="Portfolio highlights">
          {metrics.map(([value, label]) => (
            <div><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>

      <div class="concept-b-visual" aria-hidden="true">
        <figure class="hero-film">
          <video class="hero-film-video" src={`${base}/videos/hero-tell-us.mp4`} poster={`${base}/videos/hero-tell-us-poster.jpg`} autoplay muted loop playsinline preload="metadata" aria-label="Tell Us About Yourself: a 60-second animated short on how I turn ambiguous problems into shipped products"></video>
          <figcaption>Tell Us About Yourself — a 60-second short</figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="concept-b-work" aria-labelledby="work-title">
      <div class="concept-b-section-head">
        <div>
          <p>Selected product work</p>
          <h2 id="work-title">Six products. Different problems. Same product discipline.</h2>
        </div>
        <span>From systems scale to measurable business impact.</span>
      </div>

      <div class="concept-b-project-grid">
        {projects.map((project, index) => (
          <a
            class="concept-b-project"
            data-tone={project.tone}
            href={`${base}/work/${project.slug}/`}
            aria-label={`Open ${project.title} case study`}
          >
            <div class="concept-b-project-visual">
              <div class={`approved-project-snip snip-${project.visual}`} aria-hidden="true"></div>
              <div class="concept-b-project-number">0{index + 1}</div>
              <div class="concept-b-project-symbol"><ProjectSymbol slug={project.slug} /></div>
            </div>
            <div class="concept-b-project-copy">
              <span>{project.group}</span>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <b aria-hidden="true">↗</b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="approach" class="concept-b-bottom-grid approach-grid" aria-label="Product leadership approach">
      <article class="concept-b-panel approach-panel approach-panel-method">
        <div class="concept-b-panel-icon" aria-hidden="true">◎</div>
        <div class="approach-panel-copy">
          <p class="concept-b-panel-kicker">How I work</p>
          <h2>Frame the problem. Prioritize the trade-offs. Prove the outcome.</h2>
          <p class="approach-summary">I turn ambiguous requests into a clear decision path before delivery starts.</p>
          <div class="approach-flow" aria-label="Product approach">
            <div><span>01</span><strong>Frame</strong><small>Problem · users · constraints</small></div>
            <b aria-hidden="true">→</b>
            <div><span>02</span><strong>Prioritize</strong><small>Value · risk · dependencies</small></div>
            <b aria-hidden="true">→</b>
            <div><span>03</span><strong>Prove</strong><small>Ship · measure · scale</small></div>
          </div>
        </div>
      </article>

      <article class="concept-b-panel concept-b-panel-ai approach-panel approach-panel-ai">
        <div class="concept-b-panel-icon" aria-hidden="true">✦</div>
        <div class="approach-panel-copy">
          <p class="concept-b-panel-kicker">How AI changed my approach</p>
          <h2>AI compresses the analysis. I keep the judgment.</h2>
          <p class="approach-summary">AI helps me get to evidence faster. Product direction, trade-offs, and accountability stay with me.</p>
          <div class="ai-approach-split">
            <div class="ai-approach-side">
              <span>AI accelerates</span>
              <strong>Research · synthesize · compare · surface gaps</strong>
            </div>
            <b aria-hidden="true">→</b>
            <div class="ai-approach-side ai-approach-human">
              <span>I decide</span>
              <strong>Priority · trade-offs · direction · success</strong>
            </div>
          </div>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
.system-visual {
  --blue: #2563eb;
  --cyan: #0891b2;
  --violet: #7c3aed;
  --orange: #ea580c;
  --faint: #94a3b8;
}


    .system-visual { position: relative; width: 100%; max-width: 600px; margin-inline: auto; aspect-ratio: 1 / 1.02; min-height: 460px; perspective: 1100px; }

    .system-visual::after { content: ""; position: absolute; left: 5%; right: 4%; bottom: 3%; height: 18%; background: radial-gradient(ellipse, rgba(124, 58, 237, .10), transparent 68%); filter: blur(24px); opacity: .7; }


    .system-visual { filter: drop-shadow(0 18px 28px rgba(15,23,42,.14)); }

    .system-visual::before {
      content: "";
      position: absolute;
      inset: 5% -4% 1% -8%;
      background: radial-gradient(ellipse at center, rgba(124, 58, 237, .08), transparent 63%);
      filter: blur(13px);
      pointer-events: none;
    }


    /* The hero turns the noise of product work into a clear operating system. */
    .signal-stage {
      position: absolute;
      inset: 18px 0 8px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      border-radius: 28px;
      background:
        linear-gradient(#eef2f7 1px, transparent 1px),
        linear-gradient(90deg, #eef2f7 1px, transparent 1px),
        radial-gradient(circle at 50% 50%, rgba(124, 58, 237, .07), transparent 46%),
        #ffffff;
      background-size: 34px 34px, 34px 34px, auto, auto;
      box-shadow: 0 24px 60px -24px rgba(15,23,42,.18);
      mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    }

    .signal-stage::before,
    .signal-stage::after {
      content: "";
      position: absolute;
      inset: 50% auto auto 50%;
      width: 104px;
      height: 104px;
      border: 1px solid rgba(37, 99, 235, .25);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(.2);
      opacity: 0;
      animation: signalEcho 12s ease-out infinite;
    }

    .signal-stage::after { animation-delay: .42s; }

    .signal-word {
      position: absolute;
      left: var(--x);
      top: var(--y);
      z-index: 2;
      padding: 5px 9px;
      border: 1px solid color-mix(in srgb, var(--word-tone, var(--blue)) 45%, transparent);
      border-radius: 999px;
      background: #ffffff;
      color: #334155;
      box-shadow: 0 2px 10px rgba(15,23,42,.08);
      font-size: clamp(.5rem, .62vw, .64rem);
      font-weight: 700;
      white-space: nowrap;
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--r)) scale(.82);
      animation: gatherSignal 12s cubic-bezier(.55, .05, .25, 1) infinite;
      animation-delay: calc(var(--delay) - 2s);
    }

    .signal-word:nth-child(3n) { --word-tone: var(--cyan); }

    .signal-word:nth-child(3n + 2) { --word-tone: var(--violet); }

    .signal-core {
      position: absolute;
      z-index: 3;
      left: 50%;
      top: 50%;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #2563eb;
      box-shadow: 0 0 16px #60a5fa, 0 0 44px rgba(37, 99, 235, .5);
      opacity: 0;
      transform: translate(-50%, -50%) scale(.3);
      animation: coreResolve 12s ease-in-out infinite;
    }

    .signal-framework {
      position: absolute;
      z-index: 4;
      inset: 35px 36px 31px 36px;
      display: grid;
      grid-template-rows: repeat(4, 1fr);
      gap: 9px;
      pointer-events: none;
    }

    .signal-layer {
      --tone: var(--blue);
      display: grid;
      grid-template-columns: 34px 1fr auto;
      align-items: center;
      gap: 12px;
      min-height: 0;
      padding: 10px 15px;
      border: 1px solid color-mix(in srgb, var(--tone) 32%, #e2e8f0);
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 10px 26px -12px rgba(15,23,42,.18);
      opacity: 0;
      transform: translateX(28px) scale(.97);
      animation: frameworkResolve 12s cubic-bezier(.2, .75, .2, 1) infinite;
      animation-delay: var(--layer-delay);
    }

    .signal-layer:nth-child(1) { --tone: var(--violet); --layer-delay: 0s; }

    .signal-layer:nth-child(2) { --tone: var(--blue); --layer-delay: .16s; }

    .signal-layer:nth-child(3) { --tone: var(--cyan); --layer-delay: .32s; }

    .signal-layer:nth-child(4) { --tone: var(--orange); --layer-delay: .48s; }

    .signal-layer svg { width: 25px; color: var(--tone); }

    .signal-layer strong { display: block; color: #0f172a; font-family: Sora, sans-serif; font-size: clamp(.78rem, 1vw, .94rem); letter-spacing: -.02em; }

    .signal-layer small { display: block; margin-top: 1px; color: #64748b; font-size: clamp(.48rem, .6vw, .59rem); }

    .signal-layer em { color: var(--tone); font-size: .52rem; font-style: normal; font-weight: 800; letter-spacing: .09em; }

    .signal-caption {
      position: absolute;
      z-index: 5;
      left: 50%;
      bottom: 7px;
      color: var(--faint);
      font-size: .56rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(-50%);
      animation: captionCycle 12s ease infinite;
    }

      @media (max-width: 760px) {
  .system-visual { min-height: 390px; margin-top: 30px; aspect-ratio: auto; }
  /* thin the word cloud on small screens so it stays airy */
  .system-visual .signal-word:nth-child(4n+1) { display: none; }
}

      /* (moved into prefers-reduced-motion below) */

      /* (moved into prefers-reduced-motion below) */
@keyframes gatherSignal {
      0%, 31% { left: var(--x); top: var(--y); opacity: .92; transform: translate(-50%, -50%) rotate(var(--r)) scale(1); }
      38% { left: var(--x); top: var(--y); opacity: 1; transform: translate(-50%, -50%) rotate(0) scale(1.04); }
      51% { left: 50%; top: 50%; opacity: .78; transform: translate(-50%, -50%) rotate(0) scale(.58); }
      57%, 100% { left: 50%; top: 50%; opacity: 0; transform: translate(-50%, -50%) rotate(0) scale(.25); }
    }
@keyframes signalEcho {
      0%, 43% { opacity: 0; transform: translate(-50%, -50%) scale(.15); }
      48% { opacity: .8; }
      63%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(4.5); }
    }
@keyframes coreResolve {
      0%, 42% { opacity: 0; transform: translate(-50%, -50%) scale(.3); }
      49% { opacity: 1; transform: translate(-50%, -50%) scale(1.65); }
      58% { opacity: .9; transform: translate(-50%, -50%) scale(1); }
      65%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(.45); }
    }
@keyframes frameworkResolve {
      0%, 52% { opacity: 0; transform: translateX(28px) scale(.97); }
      60%, 89% { opacity: 1; transform: translateX(0) scale(1); }
      96%, 100% { opacity: 0; transform: translateX(-10px) scale(.99); }
    }
@keyframes captionCycle {
      0%, 11%, 91%, 100% { opacity: 0; }
      16%, 43% { opacity: 1; content: ""; }
      55%, 86% { opacity: .72; }
    }
@media (prefers-reduced-motion: reduce) {
  .system-visual .signal-word,
  .system-visual .signal-core,
  .system-visual .signal-stage::before,
  .system-visual .signal-stage::after,
  .system-visual .signal-caption { display: none; }
  .system-visual /* (moved into prefers-reduced-motion below) */
}


/* Homepage approach: product method vs AI augmentation */
.approach-grid{align-items:stretch}
.approach-panel{grid-template-columns:auto minmax(0,1fr);align-items:start;min-height:220px}
.approach-panel-copy{min-width:0}
.approach-summary{max-width:560px;margin:8px 0 0!important;color:#64748b!important;font-size:.62rem!important;line-height:1.5!important}
.approach-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:8px;align-items:center;margin-top:17px}
.approach-flow>div{display:grid;gap:3px;min-width:0;padding:10px 11px;border:1px solid #e2e8f0;border-radius:11px;background:#f8fafc}
.approach-flow>div>span{color:#7c3aed;font-size:.46rem;font-weight:800;letter-spacing:.08em}
.approach-flow strong{color:#0f172a;font-size:.64rem;line-height:1.15}
.approach-flow small{color:#64748b;font-size:.47rem;line-height:1.35}
.approach-flow>b{color:#94a3b8;font-size:.58rem;font-weight:500}
.ai-approach-split{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:9px;align-items:stretch;margin-top:17px}
.ai-approach-side{display:grid;align-content:start;gap:5px;padding:11px 12px;border:1px solid #a7f3d0;border-radius:11px;background:#f0fdf4}
.ai-approach-side>span{color:#059669;font-size:.47rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.ai-approach-side>strong{color:#0f172a;font-size:.54rem;line-height:1.45;font-weight:650}
.ai-approach-human{border-color:#ddd6fe;background:#f5f3ff}
.ai-approach-human>span{color:#7c3aed}
.ai-approach-split>b{align-self:center;color:#94a3b8;font-size:.62rem}
@media(max-width:760px){
  .approach-panel{min-height:0;padding:16px}
  .approach-summary{font-size:.58rem!important}
  .approach-flow{grid-template-columns:1fr;gap:6px}
  .approach-flow>b{display:none}
  .approach-flow>div{grid-template-columns:28px 72px 1fr;align-items:center;gap:7px}
  .approach-flow small{font-size:.46rem}
  .ai-approach-split{grid-template-columns:1fr;gap:6px}
  .ai-approach-split>b{display:none}
}

</style>
