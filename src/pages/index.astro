---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSymbol from '../components/ProjectSymbol.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    slug: 'enterprise-order-management',
    title: 'Enterprise Order Management',
    group: 'Platform',
    tone: 'blue',
    summary: 'Intelligent orchestration for enterprise order flows.',
    visual: 'orchestration',
  },
  {
    slug: 'rag-analysis-agent',
    title: 'Enterprise RAG Analysis Agent',
    group: 'AI',
    tone: 'violet',
    summary: 'Grounded analysis across fragmented enterprise knowledge.',
    visual: 'rag',
  },
  {
    slug: 'build-plus',
    title: 'Build Plus',
    group: 'Operations',
    tone: 'teal',
    summary: 'Product + engineering for supply-chain operations.',
    visual: 'build',
  },
  {
    slug: 'rfds',
    title: 'Site Engineering & Field Operations',
    group: 'Operations',
    tone: 'cyan',
    summary: 'Field execution tied to governed site information.',
    visual: 'field',
  },
  {
    slug: 'gl-coding',
    title: 'Dynamic GL Coding',
    group: 'Finance',
    tone: 'amber',
    summary: 'Configurable financial routing across business units.',
    visual: 'finance',
  },
  {
    slug: 'lease-vendor-management',
    title: 'Lease & Vendor Management',
    group: 'Finance',
    tone: 'rose',
    summary: 'Vendor, lease, and payment controls at scale.',
    visual: 'lease',
  },
];

const metrics = [
  ['19+', 'Teams'],
  ['558+', 'Projects'],
  ['$1.2M', 'Cost avoided'],
  ['1,000+', 'Designs / mo'],
];
---

<BaseLayout bodyClass="portfolio-dark">
  <div class="concept-b shell">
    <section class="concept-b-hero" aria-labelledby="portfolio-title">
      <div class="concept-b-hero-copy">
        <p class="concept-b-kicker">Enterprise systems × AI × execution</p>
        <h1 id="portfolio-title">
          Complex systems.<br />
          Clear direction.<br />
          <span>Real impact.</span>
        </h1>
        <p class="concept-b-subhead">
          I’m Venkata Parimi, a Senior Technical Product Owner who turns ambiguity into product decisions and measurable outcomes.
        </p>
        <div class="concept-b-actions">
          <a class="concept-b-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a>
          <a class="concept-b-secondary" href="#approach">How I work</a>
        </div>

        <div class="concept-b-metrics" aria-label="Portfolio highlights">
          {metrics.map(([value, label]) => (
            <div><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>

      <div class="concept-b-visual" aria-hidden="true">
        <div class="concept-b-wave"></div>
        <div class="concept-b-stack">
          <div class="concept-b-layer layer-strategy"><span>01</span><strong>Strategy</strong></div>
          <div class="concept-b-layer layer-ai"><span>02</span><strong>AI Intelligence</strong></div>
          <div class="concept-b-layer layer-execution"><span>03</span><strong>Product Execution</strong></div>
          <div class="concept-b-layer layer-outcomes"><span>04</span><strong>Measurable Outcomes</strong></div>
        </div>
        <div class="concept-b-annotation">
          <i></i>
          <span>From complexity<br />to clarity</span>
        </div>
      </div>
    </section>

    <section id="work" class="concept-b-work" aria-labelledby="work-title">
      <div class="concept-b-section-head">
        <div>
          <p>Selected product work</p>
          <h2 id="work-title">Six products. Different problems. Same product discipline.</h2>
        </div>
        <span>From systems scale to measurable business impact.</span>
      </div>

      <div class="concept-b-project-grid">
        {projects.map((project, index) => (
          <a
            class="concept-b-project"
            data-tone={project.tone}
            href={`${base}/work/${project.slug}/`}
            aria-label={`Open ${project.title} case study`}
          >
            <div class="concept-b-project-visual">
              <div class={`approved-project-snip snip-${project.visual}`} aria-hidden="true"></div>
              <div class="concept-b-project-number">0{index + 1}</div>
              <div class="concept-b-project-symbol"><ProjectSymbol slug={project.slug} /></div>
            </div>
            <div class="concept-b-project-copy">
              <span>{project.group}</span>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <b aria-hidden="true">↗</b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="approach" class="concept-b-bottom-grid" aria-label="Product leadership approach">
      <article class="concept-b-panel">
        <div class="concept-b-panel-icon" aria-hidden="true">◫</div>
        <div>
          <p class="concept-b-panel-kicker">How I work</p>
          <h2>Find the real problem. Make the trade-off visible. Prove before scaling.</h2>
          <div class="concept-b-tags">
            <span>Systems thinking</span>
            <span>Customer focus</span>
            <span>Cross-functional execution</span>
          </div>
        </div>
        <a href="#work" aria-label="View product work">→</a>
      </article>

      <article class="concept-b-panel concept-b-panel-ai">
        <div class="concept-b-panel-icon" aria-hidden="true">✦</div>
        <div>
          <p class="concept-b-panel-kicker">How AI changed my work</p>
          <h2>Less coordination overhead. More time for product judgment.</h2>
          <div class="concept-b-transform">
            <span>Research</span><b>→</b><span>Synthesize</span><b>→</b><span>Decide</span>
          </div>
        </div>
        <span class="concept-b-panel-arrow" aria-hidden="true">→</span>
      </article>
    </section>
  </div>
</BaseLayout>
