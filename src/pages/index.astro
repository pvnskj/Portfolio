---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSymbol from '../components/ProjectSymbol.astro';

const base = import.meta.env.BASE_URL;

const boardRows = [
  {
    slug: 'enterprise-order-management',
    title: 'Enterprise Order Management',
    group: 'Platform',
    tone: 'blue',
    scale: '19+ teams',
    scaleNote: 'Cross-functional delivery',
    impact: 'Reduce vendor dependency with in-house orchestration',
    evidence: '20% faster mapping',
    evidenceNote: 'Measured POC',
  },
  {
    slug: 'rag-analysis-agent',
    title: 'Enterprise RAG Analysis Agent',
    group: 'AI',
    tone: 'violet',
    scale: '11GB · 558+ projects',
    scaleNote: 'Unified knowledge sources',
    impact: 'Unify business + technical analysis',
    evidence: '~10 days → ~6 hrs',
    evidenceNote: 'Analysis work',
  },
  {
    slug: 'build-plus',
    title: 'Build Plus',
    group: 'Operations',
    tone: 'teal',
    scale: '300+ requirements',
    scaleNote: 'Product + engineering',
    impact: 'Reduce manual supply-chain handoffs',
    evidence: '10K+ hrs/year',
    evidenceNote: 'Projected capacity returned',
  },
  {
    slug: 'rfds-automation',
    title: 'RFDS Automation',
    group: 'Operations',
    tone: 'cyan',
    scale: '1,000+ designs/mo',
    scaleNote: 'Engineering documents',
    impact: 'Automate engineering document generation',
    evidence: '$1.2M avoided',
    evidenceNote: 'Annual cost avoidance',
  },
  {
    slug: 'dynamic-gl-coding',
    title: 'Dynamic GL Coding',
    group: 'Finance',
    tone: 'amber',
    scale: '4+ portfolios',
    scaleNote: 'Finance + business units',
    impact: 'Make finance routing configurable and reusable',
    evidence: '40% faster close',
    evidenceNote: 'Month-end close',
  },
  {
    slug: 'lease-vendor-management',
    title: 'Lease & Vendor Management',
    group: 'Finance',
    tone: 'rose',
    scale: '$23.7M/mo',
    scaleNote: 'Rent roll governed',
    impact: 'Improve vendor, address, and payment controls',
    evidence: '~2× ROI',
    evidenceNote: 'Estimated return',
  },
];

const approachCards = [
  {
    title: 'Start with the outcome',
    body: 'Understand the problem, who it affects, and what success should look like before deciding what to build.',
    stance: 'Visionary',
    value: 'Focus',
  },
  {
    title: 'Bring the right people in',
    body: 'Connect business, design, engineering, operations, and users early enough to expose constraints and assumptions.',
    stance: 'Collaborator',
    value: 'Openness · Respect',
  },
  {
    title: 'Turn ambiguity into choices',
    body: 'Make the options and trade-offs visible, then prioritize with value, risk, effort, dependencies, and evidence.',
    stance: 'Decision Maker',
    value: 'Courage',
  },
  {
    title: 'Validate before scaling',
    body: 'Use pilots, experiments, or smaller releases when uncertainty is high before committing significant effort.',
    stance: 'Experimenter',
    value: 'Commitment',
  },
  {
    title: 'Balance user and business',
    body: 'Protect customer needs without losing sight of business outcomes, technical realities, and long-term product health.',
    stance: 'Customer Representative',
    value: 'Focus',
  },
  {
    title: 'Align, then enable',
    body: 'Create clarity around priorities and outcomes, then give teams room to solve the problem rather than prescribing implementation.',
    stance: 'Influencer',
    value: 'Respect',
  },
];

const aiShifts = [
  ['Backlog', 'Outcomes'],
  ['Stories', 'Epics'],
  ['Velocity', 'Time to market'],
  ['Fragmented knowledge', 'Shared context'],
  ['Single stream', 'Multi-product view'],
  ['Coordination', 'Customer focus'],
];
---

<BaseLayout>
  <div class="scan-home shell portfolio-home">
    <section class="portfolio-intro" aria-labelledby="portfolio-title">
      <div>
        <p class="eyebrow">Venkata Parimi · Senior Technical Product Owner</p>
        <h1 id="portfolio-title">Turning complexity into product outcomes.</h1>
      </div>
      <p>I connect business decisions with the systems behind them, from enterprise platforms to AI products.</p>
    </section>

    <section id="work" class="portfolio-board" aria-labelledby="work-title">
      <div class="portfolio-section-head">
        <div>
          <p class="eyebrow">Selected product work</p>
          <h2 id="work-title">Active work</h2>
        </div>
        <p>Six initiatives, from scale to measurable impact.</p>
      </div>

      <div class="portfolio-board-grid" role="table" aria-label="Selected product work">
        <div class="portfolio-board-header" role="row">
          <div role="columnheader"><strong>Initiative</strong><span>What I built and owned</span></div>
          <div role="columnheader"><strong>Scale</strong><span>Size and scope</span></div>
          <div role="columnheader"><strong>Product impact</strong><span>What changed</span></div>
          <div role="columnheader"><strong>Evidence</strong><span>Measured outcome</span></div>
        </div>

        {boardRows.map((row) => (
          <a class="portfolio-board-row" data-tone={row.tone} href={`${base}work/${row.slug}/`} role="row" aria-label={`Open ${row.title} case study`}>
            <div class="portfolio-board-initiative" role="cell">
              <ProjectSymbol slug={row.slug} />
              <span><small>{row.group}</small><strong>{row.title}</strong></span>
            </div>
            <div class="portfolio-board-cell" role="cell">
              <strong>{row.scale}</strong>
              <span>{row.scaleNote}</span>
            </div>
            <div class="portfolio-board-cell portfolio-impact" role="cell">
              <strong>{row.impact}</strong>
            </div>
            <div class="portfolio-board-cell portfolio-evidence" role="cell">
              <span><strong>{row.evidence}</strong><small>{row.evidenceNote}</small></span>
              <b aria-hidden="true">›</b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="approach" class="home-approach" aria-labelledby="approach-title">
      <div class="portfolio-section-head">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 id="approach-title">How I approach a challenge</h2>
        </div>
        <p>Product Owner stances and Scrum values expressed through how I work, not as a checklist.</p>
      </div>

      <div class="home-approach-track" aria-label="Product ownership approach">
        {approachCards.map((card) => (
          <article class="home-approach-card">
            <div class="home-approach-tags"><span>{card.stance}</span><i>{card.value}</i></div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-ai" aria-labelledby="ai-title">
      <div class="portfolio-section-head">
        <div>
          <p class="eyebrow">How AI changed my work</p>
          <h2 id="ai-title">Less coordination overhead. More product thinking.</h2>
        </div>
        <p>AI has not changed my accountability. It has changed how much time I can spend on the decisions that matter.</p>
      </div>

      <div class="home-ai-track" aria-label="How AI changed my product work">
        {aiShifts.map(([before, after]) => (
          <article class="home-ai-shift">
            <span>{before}</span>
            <b aria-hidden="true">→</b>
            <strong>{after}</strong>
          </article>
        ))}
      </div>
      <p class="home-ai-signoff">Faster analysis. Better context. Shorter path from customer need to product outcome.</p>
    </section>
  </div>
</BaseLayout>
